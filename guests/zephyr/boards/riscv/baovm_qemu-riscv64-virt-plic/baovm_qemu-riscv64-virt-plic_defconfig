# Zephyr runs as a Bao guest in supervisor mode, using the SBI implemented
# by the hypervisor (timer, IPIs, hart management).
CONFIG_RISCV_S_MODE=y
CONFIG_RISCV_S_MODE_EXTERNAL_SBI=y

CONFIG_XIP=n
CONFIG_STACK_SENTINEL=y
CONFIG_THREAD_STACK_INFO=y

# Enable Timer and Sys clock
CONFIG_SYS_CLOCK_TICKS_PER_SEC=1000

# Enable UART driver and console
CONFIG_SERIAL=y
CONFIG_UART_INTERRUPT_DRIVEN=y
CONFIG_CONSOLE=y
CONFIG_UART_CONSOLE=y
